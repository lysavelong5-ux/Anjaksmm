import json
from telegram import Update, ReplyKeyboardMarkup
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, filters, ContextTypes

TOKEN = "8816209068:AAF6v46VKJQd_a47GjYbBGK7uazlcW99jOI"
GROUP_CHAT_ID = -1004485383176  

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    keyboard = [
        ["🚀 បើកហាង SMM", "👑 ជំនួយការ Admin"]
    ]
    reply_markup = ReplyKeyboardMarkup(keyboard, resize_keyboard=True, persistent=True)
    await update.message.reply_text(
        "✨ ស្វាគមន៍មកកាន់ ANAJAK SMM DIGITAL! សូមចុចប៊ូតុងខាងក្រោមដើម្បីបើកមើលសេវាកម្ម៖",
        reply_markup=reply_markup
    )

# មុខងារទទួលទិន្នន័យពេលអតិថិជនចុច Submit services ពី Mini App
async def handle_web_app_data(update: Update, context: ContextTypes.DEFAULT_TYPE):
    try:
        data_json = update.message.web_app_data.data
        data = json.loads(data_json)
        
        platform = data.get("platform")
        category = data.get("category")
        link = data.get("link")
        quantity = data.get("quantity")
        total_price = data.get("total_price")
        user = update.effective_user

        # សារที่จะផ្ញើចូលទៅក្នុង Telegram Group របស់ Admin
        group_message = (
            f"🚨 <b>មានការបញ្ជាទិញ SMM ថ្មី!</b>\n\n"
            f"👤 <b>អតិថិជន:</b> @{user.username or user.first_name} (ID: {user.id})\n"
            f"📱 <b>ប្រព័ន្ធ:</b> {platform.upper()}\n"
            f"📦 <b>ប្រភេទ (Category):</b> {category}\n"
            f"🔗 <b>តំណភ្ជាប់ (Link):</b> {link}\n"
            f"📊 <b>ចំនួន (Quantity):</b> {quantity}\n"
            f"💰 <b>តម្លៃសរុប:</b> {total_price}\n\n"
            f"⏳ <i>ស្ថានភាព: កំពុងរង់ចាំ Admin ដំណើរការជូន។</i>"
        )

        # ផ្ញើសារចូលទៅក្នុងគ្រុប
        await context.bot.send_message(
            chat_id=GROUP_CHAT_ID,
            text=group_message,
            parse_mode="HTML"
        )

        # ឆ្លើយតបបញ្ជាក់ទៅអតិថិជនវិញក្នុងแชทផ្ទាល់ខ្លួន
        await update.message.reply_text(
            f"✅ <b>ការបញ្ជាទិញរបស់អ្នកបានបញ្ជូនទៅកាន់ប្រព័ន្ធជោគជ័យ!</b>\n\n"
            f"🔗 Link: {link}\n"
            f"📊 ចំនួន: {quantity}\n"
            f"💰 តម្លៃសរុប: {total_price}\n\n"
            f"🙏 សូមអរគុណសម្រាប់ការប្រើប្រាស់សេវាកម្មរបស់យើងខ្ញុំ!",
            parse_mode="HTML"
        )

    except Exception as e:
        print(f"Error: {e}")

if __name__ == "__main__":
    app = ApplicationBuilder().token(TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    # ទទួលទិន្នន័យពី Web App
    app.add_handler(MessageHandler(filters.StatusUpdate.WEB_APP_DATA | filters.TEXT, handle_web_app_data))

    print("Bot ANAJAK SMM កំពុងដំណើរការ...")
    app.run_polling()
